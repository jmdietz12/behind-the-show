:: StoryScript [script]
//Background list
const backgrounds = {
    interview: "https://jmdietz12.github.io/behind-the-show/images/interview_pov.png",
  	videoPanel: "https://jmdietz12.github.io/behind-the-show/images/video_panel_blank.png",
};

//Switching bacgrounds
$(document).on(':passagerender', function () {
    const bg = State.variables.bg;

    if (backgrounds[bg]) {
        document.body.style.backgroundImage = `url('${backgrounds[bg]}')`;
    }
});

$(document).one(':storyready', function () {

    const img = document.createElement('img');

    img.id = 'indicator';
    img.src = 'https://jmdietz12.github.io/behind-the-show/images/location_selector.png';

    document.body.appendChild(img);

    console.log("Indicator created");
});

//Defining light for scenes
const sceneHeights = {
    hide: '-50%',
  	static: '-50%',
  	houseBedroom: '22.35%',
  	houseKitchen: '22.35%',
    driveway: '26%',
    work: '29.8%',
    car: '33.6%',
  	carWoods: '33.6%',
    townSquare: '37.45%',
    beach: '41.5%',
    dock: '45.4%',
    boat: '49.3%'
};

//Displays specific indicators
$(document).on(':passagedisplay', function () {
    const img = document.getElementById('indicator');
    if (!img) return;

    const scene = State.variables.scene;

    img.style.top = sceneHeights[scene] || '25%';
    img.style.left = '18%';
});

//Sets Scene Images
$(document).one(':storyready', function () {

    const img = document.createElement('img');

    img.id = 'scene-image';

    document.body.appendChild(img);
});

//Scene Images
const sceneImages = {
  	static: "https://jmdietz12.github.io/behind-the-show/images/static.png",
    houseKitchen: "https://jmdietz12.github.io/behind-the-show/images/house_kitchen.png",
  	houseBedroom: "https://jmdietz12.github.io/behind-the-show/images/house_bedroom.png",
    driveway: "https://jmdietz12.github.io/behind-the-show/images/house.png",
    work: "https://jmdietz12.github.io/behind-the-show/images/work.png",
    car: "https://jmdietz12.github.io/behind-the-show/images/car_road.png",
  	carWoods: "https://jmdietz12.github.io/behind-the-show/images/car_woods.png",
    townSquare: "https://jmdietz12.github.io/behind-the-show/images/town_square.png",
    beach: "https://jmdietz12.github.io/behind-the-show/images/beach.png",
    dock: "https://jmdietz12.github.io/behind-the-show/images/dock.png",
    boat: "https://jmdietz12.github.io/behind-the-show/images/boat_ocean.png"
};

//Updates Scene
$(document).on(':passagedisplay', function () {

    const img = document.getElementById('scene-image');
    if (!img) return;

    const scene = State.variables.scene;

    if (sceneImages[scene]) {
        img.src = sceneImages[scene];
    }
});

//Displays with 0
$(document).on(':passagedisplay', function () {
    if (State.passage === "RatingEnding" || State.passage === "FundingEnding") return;

    if (State.variables.ratings <= 0) {
        Engine.play("RatingEnding");
    }
    else if (State.variables.funding <= 0) {
        Engine.play("FundingEnding");
    }
});

//Suspicion Endings
$(document).on(':passagedisplay', function () {

    const v = State.variables;
    const suspicion = v.suspicion;
    const current = State.passage;
  	v.returnScene = v.scene;

    // Do NOT trigger anything while inside an ending sequence
    if (v.inEnding) return;

    // Car Ending
    if (suspicion >= 3 && !v.carEndingDone) {
        v.returnPassage = current;
        v.inEnding = true;
        Engine.play("CarEnding");
        return;
    }

    // Wife Ending
    if (suspicion >= 6 && !v.wifeEndingDone) {
        v.returnPassage = current;
        v.inEnding = true;
        Engine.play("WifeEnding");
        return;
    }

    // Boat Ending
    if (suspicion >= 9 && !v.boatEndingDone) {
        v.returnPassage = current;
        v.inEnding = true;
        Engine.play("BoatEnding");
        return;
    }
});

:: StoryStylesheet [stylesheet]
body {
  background-attachment: fixed;
  background-size: contain; 
  min-height: 100vh;
  margin: 0;
  background-position: center center;
  background-repeat: no-repeat;
  background-color: black;
  transition: background-image 0.5s ease-in-out;
}

.bottom-left {
  position: absolute;
  bottom: 10%;
  left: 17%;
  width: 25%;
  text-align: left;

  background: rgba(0, 0, 0, 0.7);
  color: white;

  padding: 10px;
  border: 2px solid white;

  display: inline-block;
  text-align: center;
  font-family: "Silkscreen";

  font-size: 18px;
  z-index: 2;
}

.bottom-right {
  position: absolute;
  bottom: 10%;
  right: 17%;
  width: 25%;

  background: rgba(0, 0, 0, 0.7);
  color: white;

  padding: 10px;
  border: 2px solid white;

  display: inline-block;
  text-align: center;
  font-family: "Silkscreen";

  font-size: 18px;
  z-index: 2;
}

.ratingsBar {
  position: absolute;
  top: 18.4%;
  right: 17.9%;
  text-align: left;
  color: white;
  text-shadow: 2px 2px 4px white;
}

.fundingBar {
  position: absolute;
  top: 54.4%;
  right: 17.9%;
  text-align: right;
  color: white;
  text-shadow: 2px 2px 4px white;
}

.textbox {
  position: absolute;

  top: 0%;
  left: 50%;
  transform: translateX(-50%);

  width: 67vw;

  max-height: 80vh;
  overflow-y: auto;

  background: rgba(0, 0, 0, 0.7);
  color: white;

  padding: 10px;
  border: 2px solid white;

  display: block;
  text-align: center;
  font-family: "Silkscreen";

  font-size: 24px;
  z-index: 2;
}

.meter-fill.funding-color {
  background-color: #FFEE00
}

.meter-container {
  position: relative;
  width: 60px;
  height: 200px;
  background-color: #525273;
  overflow: hidden;
}

.meter-fill {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 0%;
  background-color: #FFEE00;
  transition: height 0.4s ease-in-out;
}

#indicator {
  position: absolute;

  width: auto;
  height: auto;

  max-width: none;
  max-height: none;

  z-index: 999;
  pointer-events: none;
}

#scene-image {
  position: fixed;

  top: 56.5%;
  left: 51.5%;

  transform: translate(-50%, -50%);

  width: 44.5vw;
  height: auto;

  max-height: 100vh;

  object-fit: contain;

  z-index: 1;
  pointer-events: none;
}

@font-face {
	font-family: "Silkscreen";
	src: url(https://jmdietz12.github.io/behind-the-show/font/slkscr.ttf);
	font-style: normal;
	font-weight: normal;
}

#debug {
  position: fixed;
  top: 10px;
  left: 10px;

  background: rgba(0, 0, 0, 0.8);
  color: lime;

  padding: 8px;
  font-size: 14px;
  font-family: monospace;

  z-index: 9999;
}